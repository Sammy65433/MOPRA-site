PORT=5050
MONGODB_URI=mongodb://127.0.0.1:27017/mopra

CLIENT_URL=http://localhost:5173
APP_URL=http://localhost:5173

# Ticket sales settings
TICKET_PRICE_USD=100
RAFFLE_CAPACITY=200

# Digital ticket & reservation email (SMTP).
# Leave SMTP_HOST empty for now while testing — the website will still save reservations
# and provide the 1-click Gmail + QR payment buttons.
# When you set up GoDaddy Microsoft 365 / Outlook for mopra.org with the client later, use:
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_USER=info@mopra.org
# SMTP_PASS=your_outlook_password
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@mopra.org
ORGANIZER_EMAIL=Cahctca@gmail.com

# Staff admin access token for /api/admin endpoints and the /admin page
ADMIN_TOKEN=change-me-to-a-long-random-string
